    <worksheet name='Drop-Off Persona Distribution'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontname='Tableau Medium' fontsize='11'>Drop-Off Persona Distribution</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='customer_dropoff_analysis_dataset' name='federated.18u75dq13xu9fk1frr9sb0ciae5c' />
          </datasources>
          <datasource-dependencies datasource='federated.18u75dq13xu9fk1frr9sb0ciae5c'>
            <column caption='Sentiment' datatype='string' name='[Calculation_782852305337815045]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([feedback_comment], &quot;Poor&quot;)&#10;OR CONTAINS([feedback_comment], &quot;delay&quot;)&#10;OR CONTAINS([feedback_comment], &quot;crash&quot;)&#10;OR CONTAINS([feedback_comment], &quot;expensive&quot;)&#10;OR CONTAINS([feedback_comment], &quot;not helpful&quot;)&#10;THEN &quot;Negative&quot;&#10;&#10;ELSEIF CONTAINS([feedback_comment], &quot;Great&quot;)&#10;OR CONTAINS([feedback_comment], &quot;Loved&quot;)&#10;OR CONTAINS([feedback_comment], &quot;Satisfied&quot;)&#10;THEN &quot;Positive&quot;&#10;&#10;ELSE &quot;Neutral&quot;&#10;END' />
            </column>
            <column caption='Drop-Off Persona' datatype='string' name='[Calculation_782852305338548230]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [discount_received] = 1 AND [discount_used] = 0 AND [days_since_last_activity] &gt;= 30 THEN&#10;    &quot;Discount-Dependent Drop-Off&quot;&#10;&#10;ELSEIF [Calculation_782852305337815045] = &quot;Negative&quot; AND [days_since_last_activity] &gt;= 20 THEN&#10;    &quot;Experience-Driven Drop-Off&quot;&#10;&#10;ELSEIF ([Calculation_782852305337815045] = &quot;Positive&quot; OR [Calculation_782852305337815045] = &quot;Neutral&quot;)&#10;      AND [days_since_last_activity] &gt;= 40 THEN&#10;    &quot;Silent Drop-Off&quot;&#10;&#10;ELSEIF [engagement_day] = &quot;Weekend&quot; AND [days_since_last_activity] &gt;= 30 THEN&#10;    &quot;Timing-Mismatch User&quot;&#10;&#10;ELSE&#10;    &quot;Active / Low Risk&quot;&#10;END' />
            </column>
            <column-instance column='[customer_id]' derivation='CountD' name='[ctd:customer_id:qk]' pivot='key' type='quantitative' />
            <column caption='Customer Id' datatype='integer' name='[customer_id]' role='dimension' type='ordinal' />
            <column caption='Days Since Last Activity' datatype='integer' name='[days_since_last_activity]' role='measure' type='quantitative' />
            <column caption='Discount Received' datatype='integer' name='[discount_received]' role='measure' type='quantitative' />
            <column caption='Discount Used' datatype='integer' name='[discount_used]' role='measure' type='quantitative' />
            <column caption='Engagement Day' datatype='string' name='[engagement_day]' role='dimension' type='nominal' />
            <column caption='Feedback Comment' datatype='string' name='[feedback_comment]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_782852305338548230]' derivation='None' name='[none:Calculation_782852305338548230:nk]' pivot='key' type='nominal' />
