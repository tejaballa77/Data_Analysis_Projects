      <aliases enabled='yes' />
      <column caption='Net Revenue' datatype='real' name='[Calculation_700098661187743744]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([bill_amount]) - SUM([discount_amount])' />
      </column>
      <column caption='Offer Profit' datatype='real' name='[Calculation_700098661188554753]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [offer_taken] = &apos;Yes&apos; THEN &#10;299 - [discount_amount]&#10;ELSE 0 &#10;END' />
      </column>
      <column caption='Age Group' datatype='string' name='[Calculation_700098661191110658]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [age] &lt;= 25 THEN &quot;18–25&quot;&#10;ELSEIF [age] &lt;= 35 THEN &quot;26–35&quot;&#10;ELSEIF [age] &lt;= 45 THEN &quot;36–45&quot;&#10;ELSEIF [age] &lt;= 60 THEN &quot;46–60&quot;&#10;ELSE &quot;60+&quot;&#10;END' />
      </column>
